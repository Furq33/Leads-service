# LeadVault environment variables.
# Copy to .env.local and fill in real values. NEVER commit real secrets.

# --- Supabase (public; safe to expose in the browser) ---
# Project API URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
# Project anon/public API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# --- Supabase (secrets; server-side only) ---
# Service-role key. Full DB access — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key
# Database connection URL (direct/postgres), used by migrations/scripts.
SUPABASE_URL=postgresql://postgres:placeholder@db.placeholder.supabase.co:5432/postgres

# --- Stripe (secrets; server-side only) ---
# Stripe secret key (sk_live_... / sk_test_...)
STRIPE_SECRET_KEY=placeholder-stripe-secret-key
# Webhook signing secret for the Stripe webhook endpoint (whsec_...)
STRIPE_WEBHOOK_SECRET=placeholder-stripe-webhook-secret
# Price ID of the monthly subscription plan (price_...)
STRIPE_PRICE_ID_MONTHLY=price_placeholder_monthly

# --- App ---
# Public base URL of the deployed app, e.g. https://app.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (secret; server-side only) ---
# Resend API key for transactional email (re_...)
RESEND_API_KEY=placeholder-resend-api-key

# --- Observability ---
# Sentry DSN for error tracking
SENTRY_DSN=
# Log level: debug | info | warn | error
LOG_LEVEL=info
